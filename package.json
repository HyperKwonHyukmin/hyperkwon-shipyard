{
  "name": "hyperkwon-shipyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8797 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8798 --strictPort",
    "dev:mp": "vite build && wrangler dev --port 8796"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/three": "0.170.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "wrangler": "^4.149.0"
  }
}
